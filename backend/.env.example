# Copy to backend/.env and fill in. Never commit backend/.env.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/timesheet?schema=public"
PORT=5000
NODE_ENV=development
JWT_SECRET=generate-with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
FRONTEND_URL=http://localhost:3000
# UPLOADS_DIR=./uploads   (defaults to backend/uploads)

# Outgoing email (compliance reminders/escalations, admin test email). Leave blank to keep email off;
# the portal then says plainly that email was not sent. Office 365: smtp.office365.com, port 587, SECURE=false.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="ASA Portal <notifications@asaind.co.in>"
