# Copy to backend/.env and fill in. Never commit backend/.env.
DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/timesheet?schema=public"
PORT=5000
NODE_ENV=development
JWT_SECRET=generate-with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
FRONTEND_URL=http://localhost:3000
# UPLOADS_DIR=./uploads   (defaults to backend/uploads)
