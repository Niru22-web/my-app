model Ticket {
  id            String             @id @default(uuid())
  ticketId      String?            @unique
  description   String
  status        String             @default("Open")
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  assignedTo    String?
  createdById   String
  priority      String?
  title         String
  category      String?            @default("IT Support")
  categoryId    Int?               @map("category_id")
  subcategoryId Int?               @map("subcategory_id")
  attachmentUrl String?
  attachments   TicketAttachment[]
  history       TicketHistory[]
  createdBy     Employee           @relation("TicketCreator", fields: [createdById], references: [id])
  categoryRel   HelpdeskCategory?  @relation("TicketCategory", fields: [categoryId], references: [id])
  subcategoryRel HelpdeskCategory? @relation("TicketSubcategory", fields: [subcategoryId], references: [id])

  @@map("tickets")
}

model HelpdeskCategory {
