  version     Int
  description String
  modifiedBy  String
  createdAt   DateTime @default(now())
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("report_history")
}

model ScheduledRefresh {
  id          String   @id @default(uuid())
  reportId    String
  interval    String   // "manual", "5m", "15m", "30m", "1h", "daily", "weekly"
  lastRefresh DateTime @default(now())
  nextRefresh DateTime?
  isActive    Boolean  @default(true)
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("scheduled_refreshes")
}

model SavedView {
  id          String   @id @default(uuid())
  reportId    String
  userId      String
  name        String
  filters     Json?
  sorting     Json?
  theme       String?
  pageId      String?
  layout      Json?
  isDefault   Boolean  @default(false)
  report      Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("saved_views")
}

model Bookmark {
  id             String   @id @default(uuid())
  reportId       String
  userId         String
  name           String
  filters        Json?
  sorting        Json?
  pageId         String?
  selectedVisual String?
  theme          String?
  zoom           Float?
  createdAt      DateTime @default(now())
  report         Report   @relation(fields: [reportId], references: [id], onDelete: Cascade)

  @@map("bookmarks")
}

model ReportFilter {
  id         String     @id @default(uuid())
  pageId     String?    // if page-level filter
  reportId   String?    // if report-level filter
  visualId   String?    // if visual-level filter
  field      String     // field name
  filterType String     // "visual", "page", "report"
  operator   String     // "equals", "contains", "between", "topN", etc.
  value      Json       // filter value(s)
  page       ReportPage? @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@map("report_filters")
}

model AIQueryHistory {
  id        String   @id @default(uuid())
  userId    String
  query     String
  sqlQuery  String?
  createdAt DateTime @default(now())

  @@map("ai_query_history")
}

model TeamMessage {
  id          String   @id @default(uuid())
  senderId    String
  senderName  String
  senderRole  String
  senderImage String?
  content     String
  createdAt   DateTime @default(now())

  @@map("team_messages")
}


