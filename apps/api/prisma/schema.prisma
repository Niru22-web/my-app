  role                  String   @unique
  adminPanelCreate      Boolean  @default(false)
  adminPanelDelete      Boolean  @default(false)
  adminPanelEdit        Boolean  @default(false)
  adminPanelView        Boolean  @default(false)
  clientsCreate         Boolean  @default(false)
  clientsDelete         Boolean  @default(false)
  clientsEdit           Boolean  @default(false)
  clientsView           Boolean  @default(false)
  createdAt             DateTime @default(now())
  dashboardCreate       Boolean  @default(false)
  dashboardDelete       Boolean  @default(false)
  dashboardEdit         Boolean  @default(false)
  dashboardView         Boolean  @default(true)
  emailTemplatesCreate  Boolean  @default(false)
  emailTemplatesDelete  Boolean  @default(false)
  emailTemplatesEdit    Boolean  @default(false)
  emailTemplatesView    Boolean  @default(false)
  employeesCreate       Boolean  @default(false)
  employeesDelete       Boolean  @default(false)
  employeesEdit         Boolean  @default(false)
  employeesView         Boolean  @default(false)
  jobsCreate            Boolean  @default(false)
  jobsDelete            Boolean  @default(false)
  jobsEdit              Boolean  @default(false)
  jobsView              Boolean  @default(false)
  projectsCreate        Boolean  @default(false)
  projectsDelete        Boolean  @default(false)
  projectsEdit          Boolean  @default(false)
  projectsView          Boolean  @default(true)
  reportsCreate         Boolean  @default(false)
  reportsDelete         Boolean  @default(false)
  reportsEdit           Boolean  @default(false)
  reportsView           Boolean  @default(true)
  timesheetCreate       Boolean  @default(true)
  timesheetDelete       Boolean  @default(false)
  timesheetEdit         Boolean  @default(true)
  timesheetView         Boolean  @default(true)
  updatedAt             DateTime @updatedAt
  analyticsView         Boolean  @default(false)
  attendanceCreate      Boolean  @default(false)
  attendanceDelete      Boolean  @default(false)
  attendanceEdit        Boolean  @default(false)
  attendanceView        Boolean  @default(false)
  leaveManagementCreate Boolean  @default(false)
  leaveManagementDelete Boolean  @default(false)
  leaveManagementEdit   Boolean  @default(false)
  leaveManagementView   Boolean  @default(false)
  reimbursementCreate   Boolean  @default(false)
  reimbursementDelete   Boolean  @default(false)
  reimbursementEdit     Boolean  @default(false)
  reimbursementView     Boolean  @default(false)
  inboxView              Boolean  @default(false)
  inboxCreate            Boolean  @default(false)
  inboxEdit              Boolean  @default(false)
  inboxDelete            Boolean  @default(false)
  calendarView           Boolean  @default(false)
  calendarCreate         Boolean  @default(false)
  calendarEdit           Boolean  @default(false)
  calendarDelete         Boolean  @default(false)
  complianceView         Boolean  @default(false)
  complianceCreate       Boolean  @default(false)
  complianceEdit         Boolean  @default(false)
  complianceDelete       Boolean  @default(false)
  helpDeskView           Boolean  @default(false)
  helpDeskCreate         Boolean  @default(false)
  helpDeskEdit           Boolean  @default(false)
  helpDeskDelete         Boolean  @default(false)
  assetManagementView    Boolean  @default(false)
  assetManagementCreate  Boolean  @default(false)
  assetManagementEdit    Boolean  @default(false)
  assetManagementDelete  Boolean  @default(false)
  accountsView           Boolean  @default(false)
  accountsCreate         Boolean  @default(false)
  accountsEdit           Boolean  @default(false)
  accountsDelete         Boolean  @default(false)

  @@map("role_permissions")
}

model EmailLog {
  id           String   @id @default(uuid())
  recipient    String
  subject      String
  status       String   @default("pending")
  errorMessage String?
  sentAt       DateTime @default(now())
  provider     String   @default("outlook")
  category     String   @default("registration")
  employeeId   String?

  @@map("email_logs")
}

model EmployeeDocument {
  id         String   @id @default(uuid())
  employeeId String
  title      String
  category   String   @default("Other")
  fileName   String
  filePath   String
  fileSize   Int
  mimeType   String
  uploadedAt DateTime @default(now())
  uploadedBy String?
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("employee_documents")
}

model Notification {
  id           String    @id @default(uuid())
  message      String
  type         String
  isRead       Boolean   @default(false)
  createdAt    DateTime  @default(now())
  userId       String
  relatedId    String?
  actionUrl    String?
  title        String    @default("Notification")
  module       String    @default("Employee")
  priority     String    @default("Info")
  isArchived   Boolean   @default(false)
  isPinned     Boolean   @default(false)
  isStarred    Boolean   @default(false)
  snoozedUntil DateTime?
  metadata     Json?
  user         Employee  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Activity {
  id          String    @id @default(uuid())
  title       String
  description String
  type        String
  createdAt   DateTime  @default(now())
  userId      String?
  relatedId   String?
  user        Employee? @relation(fields: [userId], references: [id])

  @@map("activities")
}

model Leave {
  id                 String    @id @default(uuid())
  leaveId            String    @unique
  type               String
  fromDate           DateTime
  toDate             DateTime
  duration           String
  totalDays          Float
  reason             String
  status             String    @default("pending")
  appliedDate        DateTime  @default(now())
  approvedBy         String?
  approvedDate       DateTime?
  employeeId         String
reportingManagerId String?
reportingPartnerId String?
  approvedRole       String?
  approver           Employee? @relation("LeaveApprover", fields: [approvedBy], references: [id])
  employee           Employee  @relation("EmployeeLeaves", fields: [employeeId], references: [id])

  @@map("leaves")
}

model LeaveBalance {
  id              String   @id @default(uuid())
  employeeId      String
  createdAt       DateTime @default(now())
  remainingLeaves Float    @default(21)
  totalLeaves     Float    @default(21)
  updatedAt       DateTime @updatedAt
  usedLeaves      Float    @default(0)
  year            Int
  employee        Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, year], name: "employeeId_year")
  @@map("leave_balance")
}

model Reimbursement {
  id                String                    @id @default(uuid())
  claimId           String                    @unique
  category          String
  amount            Float
  description       String?
  date              DateTime                  @default(now())
  status            String                    @default("PENDING_MANAGER")
  employeeId        String
  clientId          String?
  jobId             String?
  projectId         String?
  remarks           String?
  submittedAt       DateTime                  @default(now())
  approvalLevel     Int                       @default(1)
  managerApprovedAt DateTime?
  managerApprovedBy String?
  managerId         String?
  partnerApprovedAt DateTime?
  partnerApprovedBy String?
  partnerId         String?
  rejectionReason   String?
  submittedBy       String?
  accountantRemarks String?
  bankReference     String?
  deductions        Float?                    @default(0)
  gstAmount         Float?                    @default(0)
  netPayable        Float?                    @default(0)
  paymentDate       DateTime?
  paymentMode       String?
  paymentStatus     String?                   @default("Pending")
  processedAt       DateTime?
  processedById     String?
  tdsAmount         Float?                    @default(0)
  utrNumber         String?
  approvedAt        DateTime?
  approvedBy        String?
  paidAt            DateTime?
  rejectedAt        DateTime?
  updatedAt         DateTime                  @default(now()) @updatedAt
  attachments       ReimbursementAttachment[]
  logs              ReimbursementLog[]
  finalApprover     Employee?                 @relation("ReimbursementFinalApprover", fields: [approvedBy], references: [id])
  client            Client?                   @relation(fields: [clientId], references: [id])
  employee          Employee                  @relation("EmployeeReimbursements", fields: [employeeId], references: [id])
  job               Job?                      @relation(fields: [jobId], references: [id])
  managerApprover   Employee?                 @relation("ReimbursementManagerApprover", fields: [managerApprovedBy], references: [id])
  manager           Employee?                 @relation("ReimbursementManager", fields: [managerId], references: [id])
  partnerApprover   Employee?                 @relation("ReimbursementPartnerApprover", fields: [partnerApprovedBy], references: [id])
  partner           Employee?                 @relation("ReimbursementPartner", fields: [partnerId], references: [id])
  processedBy       Employee?                 @relation("ReimbursementProcessor", fields: [processedById], references: [id])
  project           Project?                  @relation(fields: [projectId], references: [id])

  @@map("reimbursements")
}

model ReimbursementAttachment {
  id              String        @id @default(uuid())
  reimbursementId String
  fileName        String
  filePath        String
  fileSize        Int
  mimeType        String
  uploadedAt      DateTime      @default(now())
  reimbursement   Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)

  @@map("reimbursement_attachments")
}

model ReimbursementLog {
  id              String        @id @default(uuid())
  reimbursementId String
  action          String
  status          String
  remarks         String?
  performedById   String
  performedAt     DateTime      @default(now())
  performedBy     Employee      @relation(fields: [performedById], references: [id])
  reimbursement   Reimbursement @relation(fields: [reimbursementId], references: [id], onDelete: Cascade)

  @@map("reimbursement_logs")
}

model attendance {
  id                  String                @id
  employee_id         String
  check_in_time       DateTime?
  check_out_time      DateTime?
  check_in_location   String?
  check_out_location  String?
  date                DateTime              @db.Date
  status              String                @default("Absent")
  total_hours         Float                 @default(0)
  latitude            Float?
  longitude           Float?
  location_name       String?
  is_auto_checkout    Boolean               @default(false)
  attendance_source   String                @default("MANUAL")
  Employee            Employee              @relation(fields: [employee_id], references: [employeeId], onDelete: Cascade)
  attendance_sessions attendance_sessions[]

  @@unique([employee_id, date])
}

model attendance_log {
  id            String   @id @default(uuid())
  employee_id   String
  punchTime     DateTime @default(now())
  type          String
  source        String   @default("Web")
  deviceId      String?
  latitude      Float?
  location_name String?
  longitude     Float?
  Employee      Employee @relation(fields: [employee_id], references: [employeeId], onDelete: Cascade)
}

model attendance_sessions {
  id                 String     @id
  employee_id        String
  check_in_time      DateTime
  check_out_time     DateTime?
  duration           Int?       @default(0)
  date               DateTime   @db.Date
  check_in_location  String?
  check_out_location String?
  latitude           Float?
  longitude          Float?
