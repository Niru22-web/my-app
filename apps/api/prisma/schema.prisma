  created_at    DateTime           @default(now())
  updated_at    DateTime           @updatedAt

  support_email       String?
  cc_email            String?
  escalation_email    String?
  auto_assign_user_id String?

  parent        HelpdeskCategory?  @relation("CategoryHierarchy", fields: [parent_id], references: [id], onDelete: Cascade)
  children      HelpdeskCategory[] @relation("CategoryHierarchy")

  ticketsAsCategory    Ticket[] @relation("TicketCategory")
  ticketsAsSubcategory Ticket[] @relation("TicketSubcategory")

  @@map("helpdesk_categories")
}

model TicketHistory {
  id            String             @id @default(uuid())
  ticketId      String
  action        String
  fromStatus    String?
  toStatus      String?
  fromAssignee  String?
  toAssignee    String?
