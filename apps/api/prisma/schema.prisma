generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Employee {
  id                            String                  @id @default(uuid())
  employeeId                    String                  @unique
  firstName                     String
  lastName                      String
  officeEmail                   String                  @unique
  designation                   String
  status                        String                  @default("pending")
  password                      String?
  createdAt                     DateTime                @default(now())
  department                    String                  @default("General")
  reportingManager              String?
  reportingPartner              String?             
  managers                      EmployeeManager[]       @relation("EmployeeManagers")
  managedEmployees              EmployeeManager[]       @relation("ManagerEmployees")
  partners                      EmployeePartner[]       @relation("EmployeePartners")
  partnerEmployees              EmployeePartner[]       @relation("PartnerEmployees")
  role                          String                  @default("Employee")
  approvalStatus                String                  @default("PENDING")
  approvedAt                    DateTime?
  approvedBy                    String?
  profileImage                  String?
  updatedAt                     DateTime                @default(now()) @updatedAt
  hasAccountsAccess             Boolean                 @default(false)
  isApproved                    Boolean                 @default(false)
  emailConnections              EmailConnection[]
  profile                       EmployeeProfile?
  events                        Event[]
  createdJobs                   Job[]                   @relation("JobCreator")
  jobs                          JobUser[]
  createdProjects               Project[]               @relation("ProjectCreator")
  managedProjects               Project[]               @relation("ProjectManager")
  partnerProjects               Project[]               @relation("ProjectPartner")
  projects                      ProjectUser[]
  registrationTokens            RegistrationToken[]
  approvedTimelogs              Timelog[]               @relation("TimelogApprover")
  timelogs                      Timelog[]
  rejectedTimelogs              Timelog[]               @relation("TimelogRejector")
  activities                    Activity[]
  assetAllocations              AssetAllocation[]
  inventoryHistory              AssetInventoryHistory[] @relation("InventoryHistoryPerformer")
  assetActionHistory            AssetRequestHistory[]   @relation("HistoryPerformer")
  approvedAssetRequests         AssetRequest[]          @relation("AssetRequestApprover")
  assetRequests                 AssetRequest[]          @relation("EmployeeAssetRequests")
  attendance                    attendance[]
  attendance_log                attendance_log[]
  attendance_sessions           attendance_sessions[]
  assets                        employee_asset[]
  documents                     EmployeeDocument[]
  LeaveBalance                  LeaveBalance[]
  leaveTransactions             LeaveTransaction[]
  approvedLeaves                Leave[]                 @relation("LeaveApprover")
  Leave                         Leave[]                 @relation("EmployeeLeaves")
  notifications                 Notification[]
  reimbursementLogs             ReimbursementLog[]
  finalApprovedReimbursements   Reimbursement[]         @relation("ReimbursementFinalApprover")
  Reimbursement                 Reimbursement[]         @relation("EmployeeReimbursements")
  managerApprovedReimbursements Reimbursement[]         @relation("ReimbursementManagerApprover")
  managedReimbursements         Reimbursement[]         @relation("ReimbursementManager")
  partnerApprovedReimbursements Reimbursement[]         @relation("ReimbursementPartnerApprover")
  partnerReimbursements         Reimbursement[]         @relation("ReimbursementPartner")
  processedReimbursements       Reimbursement[]         @relation("ReimbursementProcessor")
  ticketActionHistory           TicketHistory[]         @relation("TicketHistoryPerformer")
  createdTickets                Ticket[]                @relation("TicketCreator")
  createdReports                Report[]                @relation("ReportCreator")
  userPermission                UserPermission?
  subManagerId                  String?
  subManager                    Employee?               @relation("EmployeeSubManager", fields: [subManagerId], references: [id])
  subManagedEmployees           Employee[]              @relation("EmployeeSubManager")
  
  managerId                     String?
  manager                       Employee?               @relation("EmployeeManager", fields: [managerId], references: [id])
  managedEmployeesBy            Employee[]              @relation("EmployeeManager")
  
  partnerId                     String?
  partner                       Employee?               @relation("EmployeePartner", fields: [partnerId], references: [id])
  partnerEmployeesBy            Employee[]              @relation("EmployeePartner")

  reportingPartnerIds           String[]                @default([])
  reportingManagerIds           String[]                @default([])
  subManagerIds                 String[]                @default([])

  roleId            String?            @map("role_id")
  roleMaster        RoleMaster?        @relation(fields: [roleId], references: [id])
  designationId     String?            @map("designation_id")
  designationMaster DesignationMaster? @relation(fields: [designationId], references: [id])
  departmentId      String?            @map("department_id")
  departmentMaster  DepartmentMaster?  @relation(fields: [departmentId], references: [id])
  shiftId           String?            @map("shift_id")
  shiftMaster       ShiftMaster?       @relation(fields: [shiftId], references: [id])
  locationId        String?            @map("location_id")
  locationMaster    Location?          @relation(fields: [locationId], references: [id])

  payrolls                      Payroll[]
  transactions                  Transaction[]
  ledgers                       Ledger[]
  invoiceItems                  InvoiceItem[]
  assetReports                  AssetReport[]
  complianceHistory             TimesheetCompliance[]   @relation("EmployeeCompliance")
  reminderHistory               ReminderHistory[]       @relation("EmployeeReminderHistory")
  esslMappings                  EsslEmployeeMapping[]

  @@map("Employee")
}

model EmployeeProfile {
  id                       String   @id @default(uuid())
  employeeId               String   @unique
  dob                      DateTime
  doj                      DateTime
  education                String?
  maritalStatus            String?
  gender                   String?
  permanentAddress         String?
  currentAddress           String?
  pan                      String?
  aadhaar                  String?
  panFileUrl               String?
  aadhaarFileUrl           String?
  currentPinCode           String?
  guardianAddress          String?
  guardianName             String?
  guardianNumber           String?
  personalEmail            String?
  personalMobile           String?
  profileImage             String? @map("employeePhotoUrl")
  accountHolderName        String?
  bankAccountNumber        String?
  bankName                 String?
  branchName               String?
  ifscCode                 String?
  bankStatementFileUrl     String?
  emergencyContactName     String?
  emergencyContactPhone    String?
  emergencyContactRelation String?
  employmentType           String?
  employmentTypeId         String?               @map("employment_type_id")
  employmentTypeMaster     EmploymentTypeMaster? @relation(fields: [employmentTypeId], references: [id])
  experience               String?
  salary                   Float?
  seniorityLevel           String?
  skills                   String[] @default([])
  employee                 Employee @relation(fields: [employeeId], references: [id])
}

model Client {
  id            String          @id @default(uuid())
  clientId      String          @unique
  name          String
  alias         String
  gstStatus     String
  gstin         String?
  pan           String
  address       String?
  country       String?
  pin           String?
  state         String?
  createdAt     DateTime        @default(now())
  createdBy     String
  partnerId     String?
  status        String          @default("Active")
  updatedAt     DateTime        @updatedAt
  projects      Project[]
  Reimbursement Reimbursement[]
  invoices      Invoice[]
  transactions  Transaction[]
  receipts      Receipt[]
  ledgers       Ledger[]
  invoiceItems  InvoiceItem[]

  @@map("Client")
}

model Project {
  id             String              @id @default(uuid())
  projectId      String              @unique
  name           String
  status         String
  startDate      DateTime
  billable       Boolean
  clientId       String
  contactPerson  String?
  createdByEmail String?
  createdBy      String?
  managerId      String?
  partnerId      String?
  endDate        DateTime?
  jobs           Job[]
  client         Client              @relation(fields: [clientId], references: [id])
  creator        Employee?           @relation("ProjectCreator", fields: [createdBy], references: [id])
  manager        Employee?           @relation("ProjectManager", fields: [managerId], references: [id])
  partner        Employee?           @relation("ProjectPartner", fields: [partnerId], references: [id])
  attachments    ProjectAttachment[]
  users          ProjectUser[]
  Reimbursement  Reimbursement[]
  invoices       Invoice[]
  transactions   Transaction[]
  invoiceItems   InvoiceItem[]

  @@map("Project")
}

model ProjectAttachment {
  id         String   @id @default(uuid())
  projectId  String
  fileName   String
  filePath   String
  fileSize   Int
  mimeType   String
  uploadedAt DateTime @default(now())
  uploadedBy String?
  project    Project  @relation(fields: [projectId], references: [id])
}

model Job {
  id             String          @id @default(uuid())
  jobId          String          @unique
  name           String
  status         String
  billable       Boolean
  projectId      String
  description    String?
  endDate        DateTime?
  startDate      DateTime?
  combinedId     String          @unique
  createdByEmail String?
  createdBy      String?
  creator        Employee?       @relation("JobCreator", fields: [createdBy], references: [id])
  project        Project         @relation(fields: [projectId], references: [id])
  users          JobUser[]
  timelogs       Timelog[]
  reimbursements Reimbursement[]

  @@map("Job")
}

model Timelog {
  id                 String    @id @default(uuid())
  hours              Float
  description        String
  date               DateTime
  employeeId         String
  jobId              String
  reportingManagerId String?
  reportingPartnerId String?
  approvedAt         DateTime?
  approvedBy         String?
  rejectedAt         DateTime?
  rejectedBy         String?
  rejectionReason    String?
  billableStatus     String    @default("billable")
  clientId           String
  combinedJobCode    String
  createdAt          DateTime  @default(now())
  projectId          String
  submissionStatus   String    @default("not_submitted")
  submittedAt        DateTime?
  updatedAt          DateTime  @updatedAt
  weekStart          DateTime
  workItem           String?
  approver           Employee? @relation("TimelogApprover", fields: [approvedBy], references: [id])
  employee           Employee  @relation(fields: [employeeId], references: [id])
  job                Job       @relation(fields: [jobId], references: [id])
  rejector           Employee? @relation("TimelogRejector", fields: [rejectedBy], references: [id])

  @@index([employeeId])
  @@index([jobId])

  @@index([date])
  @@index([submissionStatus])
  @@index([clientId])
  @@index([projectId])
  @@map("Timelog")
}

model RegistrationToken {
  id         String   @id @default(uuid())
  token      String   @unique
  email      String
  employeeId String
  expiresAt  DateTime
  isUsed     Boolean  @default(false)
  createdAt  DateTime @default(now())
  employee   Employee @relation(fields: [employeeId], references: [id])
}

model LeaveTransaction {
  id         String   @id @default(uuid())
  employeeId String
  type       String
  amount     Float
  date       DateTime @default(now())
  reason     String?
  year       Int
  employee   Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@map("leave_transactions")
}

model EmailConnection {
  id           String   @id @default(uuid())
  employeeId   String
  provider     String
  email        String
  accessToken  String
  refreshToken String
  tokenExpiry  DateTime
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  employee     Employee @relation(fields: [employeeId], references: [employeeId], onDelete: Cascade)

  @@unique([employeeId, provider])
  @@map("EmailConnection")
}

model EmailTemplate {
  id        String   @id @default(uuid())
  name      String
  category  String
  subject   String
  body      String
  variables String[] @default([])
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("email_templates")
}

model PasswordReset {
  id        String   @id @default(cuid())
  userId    String
  email     String
  token     String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@map("password_resets")
}

model UserPermission {
  id                    String   @id @default(uuid())
  userId                String   @unique
  adminPanelCreate      Boolean  @default(false)
  adminPanelDelete      Boolean  @default(false)
  adminPanelEdit        Boolean  @default(false)
  adminPanelView        Boolean  @default(false)
  clientsCreate         Boolean  @default(false)
  clientsDelete         Boolean  @default(false)
  clientsEdit           Boolean  @default(false)
  clientsView           Boolean  @default(false)
  createdAt             DateTime @default(now())
  dashboardCreate       Boolean  @default(false)
  dashboardDelete       Boolean  @default(false)
  dashboardEdit         Boolean  @default(false)
  dashboardView         Boolean  @default(true)
  emailTemplatesCreate  Boolean  @default(false)
  emailTemplatesDelete  Boolean  @default(false)
  emailTemplatesEdit    Boolean  @default(false)
  emailTemplatesView    Boolean  @default(false)
  employeesCreate       Boolean  @default(false)
  employeesDelete       Boolean  @default(false)
  employeesEdit         Boolean  @default(false)
  employeesView         Boolean  @default(false)
  jobsCreate            Boolean  @default(false)
  jobsDelete            Boolean  @default(false)
  jobsEdit              Boolean  @default(false)
  jobsView              Boolean  @default(false)
  projectsCreate        Boolean  @default(false)
  projectsDelete        Boolean  @default(false)
  projectsEdit          Boolean  @default(false)
  projectsView          Boolean  @default(true)
  reportsCreate         Boolean  @default(false)
  reportsDelete         Boolean  @default(false)
  reportsEdit           Boolean  @default(false)
  reportsView           Boolean  @default(true)
  timesheetCreate       Boolean  @default(true)
  timesheetDelete       Boolean  @default(false)
  timesheetEdit         Boolean  @default(true)
  timesheetView         Boolean  @default(true)
  updatedAt             DateTime @updatedAt
  analyticsView         Boolean  @default(false)
  attendanceCreate      Boolean  @default(false)
  attendanceDelete      Boolean  @default(false)
  attendanceEdit        Boolean  @default(false)
  attendanceView        Boolean  @default(false)
  leaveManagementCreate Boolean  @default(false)
  leaveManagementDelete Boolean  @default(false)
  leaveManagementEdit   Boolean  @default(false)
  leaveManagementView   Boolean  @default(false)
  reimbursementCreate   Boolean  @default(false)
  reimbursementDelete   Boolean  @default(false)
  reimbursementEdit     Boolean  @default(false)
  reimbursementView     Boolean  @default(false)
  inboxView              Boolean  @default(false)
  inboxCreate            Boolean  @default(false)
  inboxEdit              Boolean  @default(false)
  inboxDelete            Boolean  @default(false)
  calendarView           Boolean  @default(false)
  calendarCreate         Boolean  @default(false)
  calendarEdit           Boolean  @default(false)
  calendarDelete         Boolean  @default(false)
  complianceView         Boolean  @default(false)
  complianceCreate       Boolean  @default(false)
  complianceEdit         Boolean  @default(false)
  complianceDelete       Boolean  @default(false)
  helpDeskView           Boolean  @default(false)
  helpDeskCreate         Boolean  @default(false)
  helpDeskEdit           Boolean  @default(false)
  helpDeskDelete         Boolean  @default(false)
  assetManagementView    Boolean  @default(false)
  assetManagementCreate  Boolean  @default(false)
  assetManagementEdit    Boolean  @default(false)
  assetManagementDelete  Boolean  @default(false)
  accountsView           Boolean  @default(false)
  accountsCreate         Boolean  @default(false)
  accountsEdit           Boolean  @default(false)
  accountsDelete         Boolean  @default(false)
  user                  Employee @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_permissions")
}

