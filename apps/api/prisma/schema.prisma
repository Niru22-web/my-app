  dataSource     String         // "attendance", "employees", "projects", "clients", "assets", "leaves", "payroll", "helpdesk", "recruitment"
  dimension      String?
  metric         String?
  legendField    String?
  tooltipField   String?
  smallMultiples String?
  colorPalette   String         @default("indigo")
  properties     Json?          // Dynamic visual properties (e.g. conditional formatting, title size, etc.)
